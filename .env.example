# ─── Database (Supabase / Postgres) ──────────────────────────────────────────
# DATABASE_URL: pooled connection used by the app at runtime.
#   Supabase → use the Transaction Pooler URL (port 6543) with the suffix.
# DIRECT_URL: direct connection used by Prisma CLI (migrations, prisma.config.ts).
#   Supabase → use the Session Pooler URL (port 5432) with no suffix.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─── App URLs ────────────────────────────────────────────────────────────────
# In Vercel set these to your production domain (https://your-domain.com).
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ─── Auth secrets ────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 32
NEXTAUTH_SECRET=""
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ADMIN_TOKEN gates the /admin/[adminToken] route. Generate at least 64 chars:
#   openssl rand -hex 32
ADMIN_TOKEN=""

# ─── Email (Resend recommended) ──────────────────────────────────────────────
# Sign up at resend.com, verify a domain, create an API key.
# EMAIL_FROM must use the verified domain.
EMAIL_FROM="noreply@your-domain.com"
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD=""

# Dev-only: "console" logs verification/magic-link tokens to the server console
# instead of sending real email. Forcibly ignored in production.
EMAIL_DELIVERY_MODE="smtp"

# ─── Mall owner bootstrap ────────────────────────────────────────────────────
# Used by `npx tsx prisma/create-mall-owner.ts` to upsert a single mall owner.
# Run once locally with DIRECT_URL pointing at production to provision the
# admin account on Supabase. Leave ALLOWED_IPS empty for open access.
MALL_OWNER_EMAIL=""
MALL_OWNER_PASSWORD=""
MALL_OWNER_NAME="Mall Administrator"
MALL_OWNER_PHONE=""
MALL_OWNER_ALLOWED_IPS=""

# ─── File uploads ────────────────────────────────────────────────────────────
MAX_FILE_SIZE="5242880"  # 5 MB
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/svg+xml"

# ─── Security / rate limiting ────────────────────────────────────────────────
ALLOWED_IPS=""           # comma-separated, optional
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="900000"  # 15 min in ms

# ─── Database pool (per Node process) ────────────────────────────────────────
DB_POOL_MAX="1"                        # match DATABASE_URL connection_limit
DB_POOL_IDLE_TIMEOUT_MS="30000"
DB_POOL_CONNECTION_TIMEOUT_MS="10000"
DB_STATEMENT_TIMEOUT_MS="15000"

# ─── AI translation (optional) ───────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey. Leave empty to disable.
GEMINI_API_KEY=""

# ─── Sentry error monitoring (optional) ──────────────────────────────────────
# Leave NEXT_PUBLIC_SENTRY_DSN empty to disable Sentry entirely.
# ORG/PROJECT/AUTH_TOKEN are build-time only (used to upload source maps).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

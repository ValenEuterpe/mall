# Database
DATABASE_URL="postgresql://user:password@localhost:5432/wholesale_market"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# JWT
JWT_ACCESS_SECRET="generate-with-openssl-rand-base64-32"
JWT_REFRESH_SECRET="generate-with-openssl-rand-base64-32"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Email (Resend / SendGrid / etc)
EMAIL_FROM="noreply@wholesalemarket.com"
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="your-api-key"

# Dev-only: set to "console" to log emails instead of sending (tokens/links will appear in server logs)
# SECURITY: this mode is forcibly ignored in production.
EMAIL_DELIVERY_MODE="smtp"

# Upload
MAX_FILE_SIZE="5242880" # 5MB
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/svg+xml"

# Security
ADMIN_TOKEN="generate-random-64-char-string"
ALLOWED_IPS="127.0.0.1,192.168.1.100" # Mall owner IPs
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="900000" # 15 minutes

# Database pool (per Node process)
DB_POOL_MAX="1"                       # max concurrent pg connections
DB_POOL_IDLE_TIMEOUT_MS="30000"        # close idle clients after 30s
DB_POOL_CONNECTION_TIMEOUT_MS="10000"  # error if no client within 10s
DB_STATEMENT_TIMEOUT_MS="15000"        # cancel queries running >15s

# App
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

GEMINI_API_KEY=

# Sentry (error monitoring). Leave DSN empty in dev — SDK becomes a no-op.
# DSN is the only var the SDK needs at runtime; ORG/PROJECT/AUTH_TOKEN are build-time only (source map upload).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
